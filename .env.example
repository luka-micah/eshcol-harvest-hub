# ---------------------------------------------------------------------------
# Eshcol Harvest Hub — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Database (Neon PostgreSQL in production). Replace user/password/host with yours.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/eshcol?sslmode=require"

# Public app URL (used for absolute links, OG images, callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend API base URL.
# - Local dev (standalone API): http://localhost:4000
# - Vercel (API deployed as a serverless function in the same project): your site URL,
#   e.g. https://eshcol-harvest-hub.vercel.app
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Frontend origin allowed by the API (CORS). On Vercel set this to your site URL.
WEB_ORIGIN="http://localhost:3000"

# Port the standalone API listens on (local dev only; ignored on Vercel)
API_PORT="4000"

# Authentication (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Paystack — https://paystack.com
PAYSTACK_SECRET_KEY="your_paystack_secret_key_here"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="your_paystack_public_key_here"

# Cloudinary — https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (transactional email) — https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Eshcol Harvest Hub <hello@eshcolharvesthub.com>"

# WhatsApp (public click-to-chat number, international format, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER="2348000000000"

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=""
