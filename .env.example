# ---------------------------------------------------------------------------
# Eshcol Harvest Hub — environment configuration (frontend only)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# The site is currently a static, client-rendered storefront with no backend,
# so only public (NEXT_PUBLIC_*) variables are needed.
# ---------------------------------------------------------------------------

# Public app URL (used for absolute links, OG images, sitemap)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp (click-to-chat number, international format, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER="2348000000000"

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=""
